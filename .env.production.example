# Скопируй в .env на сервере и заполни.

# Домен, на который смотрит A-запись сервера.
DOMAIN=ms.team

# Пароль базы. Сгенерируй: openssl rand -base64 24
POSTGRES_PASSWORD=

# Ключ подписи сессий. Сгенерируй: openssl rand -base64 32
# Смена ключа разлогинивает всех — это нормально и иногда полезно.
AUTH_SECRET=

# Ключ для ручки /api/sync, которую дёргает крон. Сгенерируй:
# openssl rand -hex 24
# Пока пусто — ручка выключена: открытый эндпоинт, ходящий в чужие API,
# оставлять включённым «на всякий случай» не стоит.
SYNC_SECRET=
