generator client {
  provider = "prisma-client-js"
}

datasource db {
  // SQLite keeps the dev setup to a single file. Switch provider to
  // "postgresql" and point DATABASE_URL at the server for production —
  // no model in this schema depends on SQLite-specific behaviour.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Roles are strings because SQLite has no enum type; the union lives in
/// src/lib/roles.ts so both layers stay in step.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("BUYER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// Когда пользователь последний раз открывал уведомления — по нему считаем
  /// непрочитанные (события позже этой отметки).
  notifSeenAt  DateTime?

  buyer Buyer?
}

/// Лента событий (уведомления). Успешные действия видит их автор, командные/
/// денежные события (пополнение Brocard, добавление кабинета и т.п.) — админы.
model Activity {
  id          String   @id @default(cuid())
  kind        String   // тип: autoupload, cabinet_added, tiktok_connected, brocard_topup, team_lead …
  message     String   // человеческий текст события
  actorUserId String?  // кто сделал (для «своих» успехов)
  actorName   String   @default("") // денормализованное имя/ник для показа
  adminOnly   Boolean  @default(false) // событие видят только админы/команда
  // Идемпотентный ключ: если задан, повторное событие с тем же ключом не
  // создаётся (напр. low_balance:act_123:2026-09-17 — раз в сутки на кабинет).
  refKey      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([refKey])
}

/// A buyer is the unit everything is reported against. Kept separate from
/// User so an admin can hold a buyer profile too, and so a buyer can be
/// archived without deleting the account.
model Buyer {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle   String  @unique
  initials String
  color    String  @default("#8A8A8A")
  source   String  @default("Facebook")
  teamId   String?
  team     Team?   @relation(fields: [teamId], references: [id])
  archived Boolean @default(false)

  /// С какого дня баер в команде. Недели, целиком прошедшие до этой даты, не
  /// попадают в его расчёт — иначе оклад капал бы за время, когда он ещё не
  /// работал. null — считаем, что был всегда (старые баеры).
  startedAt DateTime?

  /// Овнер — не баер: в зарплате и в командном отчёте не участвует вовсе, его
  /// статистику видит только админ отдельным листом. Нужен, чтобы тянуть цифры
  /// по кабинетам владельцев, не смешивая их с командой.
  owner Boolean @default(false)

  /// День рождения — только справочно, в расчётах не участвует.
  birthday DateTime?

  /// Позиция в команде: 'BUYER' (баер) или 'LEAD' (тимлид). Справочно, отдельно
  /// от роли доступа. null — не задана.
  position String?

  /// When true the buyer's own consumables are subtracted before the
  /// salary rate is applied. Configurable per buyer on purpose.
  consumablesAffectSalary Boolean @default(true)

  salaryRuleId String?
  salaryRule   SalaryRule? @relation(fields: [salaryRuleId], references: [id])

  days         DayReport[]
  consumables  ConsumableEntry[]
  bonuses      Bonus[]
  payouts      Payout[]
  attendance   Attendance[]
  adTokens     AdToken[]
  tiktokTokens TiktokToken[]
  adGroups     TrackerGroup[]
  brocardTeams BrocardTeam[]

  ownerCapital     OwnerCapital?
  ownerWithdrawals OwnerWithdrawal[]
  domains          Domain[]
  brocardTransfers BrocardTransfer[]

  /// id ДОМЕННОЙ группы баера в Keitaro. Отдельно от группы кампаний
  /// (TrackerGroup): КТ сортирует домены своими группами. При покупке домен
  /// переносим из группы-склада в эту. Пусто — КТ-перенос пропускаем.
  ktDomainGroupId String @default("")
}

model Team {
  id     String  @id @default(cuid())
  name   String
  leadId String?
  buyers Buyer[]
}

/// The ladder. Tiers are stored as JSON so a rule can be reshaped without a
/// migration: [{ "fromCents": 80000, "ratePct": 30 }, ...]
model SalaryRule {
  id        String  @id @default(cuid())
  name      String
  tiersJson String
  /// Оклад за расчётный период (неделю), в рублях. Платится всегда — даже
  /// если баер не взял минимальный порог или закрыл неделю в минус. Как только
  /// процент по порогу перерастает оклад, платим процент: оклад работает
  /// нижней границей, а не добавкой сверху.
  fixedRub  Int     @default(10000)
  buyers    Buyer[]
}

model PaymentMethod {
  id            String      @id @default(cuid())
  name          String      @unique
  /// Commission in basis points: 450 = 4.50%. Snapshotted onto every day
  /// report so historic numbers never move when this changes.
  commissionBps Int         @default(450)
  archived      Boolean     @default(false)
  days          DayReport[]
}

model Offer {
  id         String  @id @default(cuid())
  name       String
  vertical   String  @default("")
  network    String  @default("")
  status     String  @default("ACTIVE")
  /// Free text — payout terms are negotiated, not computed.
  payout     String  @default("")
  geosJson   String  @default("[]")
  /// Регионы, куда лить нельзя. Хранится списком, вводится через запятую.
  bansJson   String  @default("[]")
  /// Города-исключения — отдельным списком от регионов: в кабинете они
  /// исключаются разными полями, и копировать их нужно порознь.
  citiesJson String  @default("[]")
  notesJson  String  @default("[]")
  previewUrl String?

  /// Ключ партнёрки в конструкторе: m1.top, shakes.pro, hamsters.run…
  /// Партнёрка у оффера одна, а вот гео — сколько угодно, и данные под каждое
  /// свои: см. OfferGeo.
  partnerKey String @default("")
  /// Куда уводить по кнопке «Назад». Ссылка у команды одна на все офферы,
  /// поэтому подставляется сразу и меняется редко.
  backfix    String @default("https://nutrivition.top/VXsVxCX?sun={sub_id_30}")

  geos  OfferGeo[]
  files OfferFile[]

  updatedAt DateTime    @updatedAt
  createdAt DateTime    @default(now())
  days      DayReport[]
}

/// Один оффер — много гео, и в конструктор под каждое уходят свои данные:
/// свой ID в кабинете партнёрки, свой лендинг, своя цена. Поэтому не поля
/// оффера, а отдельные строки.
model OfferGeo {
  id             String @id @default(cuid())
  offerId        String
  offer          Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /// Код гео для конструктора: cz, be, fr.
  langCode       String
  /// Язык служебных страниц. Пусто — берём код гео: почти всегда совпадают.
  uiLang         String @default("")
  /// ID оффера в кабинете партнёрки: product_id, offerId, OFFER_KEY, campaign_id.
  partnerOfferId String @default("")
  /// URL оригинального лендинга — обязателен для shakes.
  landingUrl     String @default("")
  /// Код потока, только для статистики shakes.
  streamCode     String @default("")
  /// Цена на служебных страницах: «39 €».
  price          String @default("")
  /// Исключения этого гео. У одного оффера в разных странах запрещены разные
  /// регионы и города, поэтому списки лежат на гео, а не на оффере. Общие для
  /// всех гео остаются на самом оффере — их не дублируют в каждой строке.
  bansJson       String @default("[]")
  citiesJson     String @default("[]")
  sort           Int    @default(0)

  @@index([offerId])
}

/// Превью и фото отзывов лежат прямо в базе: отдельного хранилища у нас нет,
/// а картинки маленькие. Диск контейнера для этого не годится — он пропадает
/// при пересборке.
model OfferFile {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  /// PREVIEW — превью оффера, REVIEW — фото под отзывы.
  kind      String   @default("PREVIEW")
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([offerId, kind])
}

/// One row per buyer per offer per day.
model DayReport {
  id       String   @id @default(cuid())
  date     DateTime
  buyerId  String
  buyer    Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  offerId  String?
  offer    Offer?   @relation(fields: [offerId], references: [id])
  source   String   @default("Facebook")
  geosJson String   @default("[]")

  revenueCents  Int
  spendNetCents Int

  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  /// Snapshot of the commission actually charged, in basis points.
  commissionBps   Int            @default(450)
  /// spendNet grossed up by the commission. Stored, not derived, so a later
  /// rate change cannot rewrite a closed period.
  spendGrossCents Int

  /// Когда деньги за этот день реально закинули на рекламный кабинет. Пока
  /// null — сумма висит долгом и приплюсовывается к закиду следующего дня.
  toppedUpAt DateTime?

  note String @default("")

  /// Что в последний раз записала синхронизация. Нужно, чтобы отличить «никто
  /// не трогал» от «человек поправил руками»: если текущее значение равно
  /// записанному, строку можно спокойно обновлять, если нет — правка ручная и
  /// синхронизация её не переписывает.
  spendSyncedCents   Int?
  revenueSyncedCents Int?
  syncedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, date, offerId, source])
  @@index([date])
  @@index([buyerId, date])
}

model ConsumableType {
  id      String            @id @default(cuid())
  name    String            @unique
  color   String            @default("#A5735A")
  entries ConsumableEntry[]
}

model ConsumableEntry {
  id         String         @id @default(cuid())
  date       DateTime
  typeId     String
  type       ConsumableType @relation(fields: [typeId], references: [id])
  /// Null means the cost sits on the team rather than on one buyer.
  buyerId    String?
  buyer      Buyer?         @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  qty        Int            @default(1)
  totalCents Int
  note       String         @default("")
  createdAt  DateTime       @default(now())

  @@index([date])
  @@index([buyerId, date])
}

model Bonus {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  periodKey   String
  amountCents Int
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@index([periodKey])
}

/// A month. Closing one freezes its day reports and stamps the FX rate the
/// payroll was actually computed at.
model Period {
  id            String    @id @default(cuid())
  key           String    @unique
  status        String    @default("OPEN")
  /// Курс в сотых: 8000 = 80,00 ₽/$.
  rubPerUsd     Int       @default(8000)
  /// AUTO — тянем из источника, MANUAL — задан руками и не перезаписывается.
  rateSource    String    @default("AUTO")
  rateUpdatedAt DateTime?
  closedAt      DateTime?
  payouts       Payout[]
}

model Payout {
  id       String @id @default(cuid())
  periodId String
  period   Period @relation(fields: [periodId], references: [id], onDelete: Cascade)
  buyerId  String
  buyer    Buyer  @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  profitCents     Int
  consumableCents Int
  baseCents       Int
  ratePct         Int
  salaryCents     Int
  bonusCents      Int
  totalCents      Int
  status          String    @default("PENDING")
  paidAt          DateTime?

  @@unique([periodId, buyerId])
}

/// Календарь отсутствий: опоздания, прогулы, отпуска, выходные, больничные.
/// Одна отметка на баера в день — двух причин у одного дня не бывает.
model Attendance {
  id        String   @id @default(cuid())
  date      DateTime
  buyerId   String
  buyer     Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  kind      String
  /// PENDING — заявка баера ждёт админа, APPROVED — отметка действует,
  /// REJECTED — админ отказал. Всё, что ставит админ, сразу APPROVED.
  status    String   @default("APPROVED")
  /// Минуты опоздания. Заполняется только для kind = LATE.
  minutes   Int      @default(0)
  note      String   @default("")
  createdAt DateTime @default(now())

  @@unique([buyerId, date])
  @@index([date])
}

model Setting {
  key   String @id
  value String
}

/// Every write to a money-bearing row lands here. Without it there is no
/// answer to "who changed my numbers".
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String   @default("")
  entity    String
  entityId  String
  action    String
  diffJson  String   @default("{}")
  at        DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
}

/// ─── Интеграции ────────────────────────────────────────────────────────────

/// Токен Facebook. Кабинеты у баеров лежат в разных Business Manager, поэтому
/// токен привязан к баеру: всё, что видно под ним, — его расход. Токен берётся
/// у System User в BM: он бессрочный и не завязан на чей-то личный вход.
model AdToken {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  label       String   @default("")

  // Данные FBtool
  token       String   @default("") // EAAB...
  cookiesJson String?  // Хранение кук в JSON
  proxyUrl    String?  // http://login:pass@ip:port

  enabled     Boolean  @default(true)
  status      String   @default("ACTIVE") // ACTIVE, TOKEN_EXPIRED, PROXY_ERROR
  lastSyncAt  DateTime?
  lastError   String   @default("")
  // До этого момента синхронизация токен не трогает: выставляется после
  // троттлинга или сигнала «подозрительная активность», чтобы дать аккаунту
  // остыть и не доводить до чекпоинта.
  pausedUntil DateTime?

  accounts    AdAccount[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Рекламный кабинет, найденный под токеном. Отдельной привязки к баеру нет —
/// он и так наследует владельца токена.
model AdAccount {
  id            String   @id @default(cuid())
  tokenId       String
  adToken       AdToken  @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  externalId    String   // act_123456789
  name          String   @default("")
  currency      String   @default("USD")
  accountStatus Int      @default(1) // код account_status из Facebook
  disableReason Int      @default(0) // код disable_reason: 0 нет, 1 integrity, 3 риск-платёж…
  // Баланс/лимит кабинета в минорных единицах валюты (из FB). «Остаток открута»
  // считаем: есть лимит (spendCap>0) → spendCap−amountSpent; иначе → balance.
  spendCapCents    Int   @default(0)
  amountSpentCents Int   @default(0)
  balanceCents     Int   @default(0)
  // Метка для детекта резкого скачка расхода: снимок расхода за сегодня и когда
  // он снят. Раз в ~2 часа синк сравнивает прирост со средним и, если резко,
  // шлёт уведомление.
  spendMarkCents   Int       @default(0)
  spendMarkAt      DateTime?
  // Агентский/основной кабинет среди дублей. Один и тот же act_ID виден под
  // несколькими профилями; этим флагом помечают «настоящий». Пока флаг —
  // ориентир для человека и задел под авто-расход агентских кабинетов; в
  // денежные подсчёты он ещё не заведён.
  agency        Boolean  @default(false)
  enabled       Boolean  @default(true)

  lastSpendAt DateTime?
  createdAt   DateTime    @default(now())
  days        AdAccountDay[]
  campaigns   FbCampaign[]
  ads         FbAd[]

  @@unique([tokenId, externalId])
}

model FbCampaign {
  id           String    @id @default(cuid())
  adAccountId  String
  adAccount    AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  campaignId   String    @unique // FB ID
  name         String
  status       String    // ACTIVE, PAUSED, ARCHIVED
  dailyBudget  Int?      // В центах
  updatedAt    DateTime  @updatedAt
}

/// Объявление Facebook с привязкой к кампании Keitaro.
///
/// Токен кампании КТ (`qynyTnDK` в ссылке объявления) достаём из destination
/// URL креатива — по нему расход объявления приписывается нужному потоку в КТ.
/// Пустой ktToken — ссылку не распознали; такое объявление видно в списке
/// отдельно, чтобы поправить разметку ссылки.
model FbAd {
  id           String    @id @default(cuid())
  adAccountId  String
  adAccount    AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  adId         String    @unique // ID объявления в Facebook
  name         String    @default("")
  status       String    @default("UNKNOWN") // effective_status
  /// ID адсета в FB — по нему меняем бюджет и он же группирует объявления.
  adsetId      String    @default("")
  adsetName    String    @default("")
  /// ID и имя кампании в FB — для группировки таблицы по кампаниям.
  campaignId   String    @default("")
  campaignName String    @default("")
  /// Дневной бюджет в центах — с того уровня, где он задан (адсет или кампания).
  dailyBudget  Int?
  /// ID объекта, которому слать смену бюджета: адсет или кампания (CBO).
  budgetTargetId String  @default("")
  /// Короткая подпись таргета: «40-65 HU».
  targeting    String    @default("")
  /// Превью креатива (thumbnail_url).
  thumbnailUrl String    @default("")
  linkUrl      String    @default("") // destination URL креатива
  ktToken      String    @default("") // токен кампании Keitaro из ссылки
  lastSpendAt  DateTime?
  updatedAt    DateTime  @updatedAt
  days         FbAdDay[]

  @@index([ktToken])
  @@index([adAccountId])
}

/// Дневные метрики объявления из Facebook — основа таблицы статистики.
///
/// `revenueCents` — доход из Keitaro по этому объявлению (sub_id_4 = ad_id),
/// нужен только для профита в разделе; в зарплату не идёт.
model FbAdDay {
  id           String   @id @default(cuid())
  adId         String
  ad           FbAd     @relation(fields: [adId], references: [id], onDelete: Cascade)
  date         DateTime
  spendCents   Int      @default(0)
  impressions  Int      @default(0)
  clicks       Int      @default(0) // клики по ссылке (inline_link_clicks)
  leads        Int      @default(0) // результаты/лиды из FB (actions)
  revenueCents Int      @default(0) // доход из Keitaro по ad_id
  currency     String   @default("USD")
  updatedAt    DateTime @updatedAt

  @@unique([adId, date])
  @@index([date])
}

/// Расход из Facebook, привязанный к кампании Keitaro по токену, по дням.
///
/// Сумма спенда всех объявлений с этим токеном за день. Отсюда строится ROI по
/// потокам на экране «Профит» и (этап 2) расход заливается обратно в Keitaro.
model KtCostDay {
  id             String    @id @default(cuid())
  date           DateTime
  ktToken        String    // токен кампании Keitaro
  ktCampaignId   String    @default("") // id кампании в КТ (для записи расхода через API)
  ktCampaignName String    @default("")
  spendCents     Int
  /** Клики (по ссылке) и показы из Facebook — для CTR/CPC на экране статистики. */
  clicks         Int       @default(0)
  impressions    Int       @default(0)
  currency       String    @default("USD")
  /// Когда этот расход залит в Keitaro (этап 2). null — ещё не заливали.
  pushedAt       DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([ktToken, date])
  @@index([date])
}

/// Доход и конверсии Keitaro в разрезе кампании и дня.
///
/// Тот же отчёт, что делит доход по баерам, но сохранённый по кампаниям — чтобы
/// сводить доход с расходом из ФБ на экране «Профит» и считать ROI по каждому
/// потоку, а не только по баеру.
model KtCampaignDay {
  id           String   @id @default(cuid())
  date         DateTime
  campaignId   String   // id кампании в Keitaro
  campaignName String   @default("")
  groupId      String   @default("")
  revenueCents Int      @default(0)
  conversions  Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([campaignId, date])
  @@index([date])
}

/// Дневной расход кабинета из Facebook — ИНФОРМАТИВНО.
///
/// Реальный расход команды приходит из Brocard: там фактические списания с
/// карт. Цифра из ФБ нужна для будущего мониторинга и управления кампаниями, а
/// не для зарплаты, поэтому лежит отдельно и в отчёты дня не попадает — иначе
/// подменила бы настоящий расход.
model AdAccountDay {
  id         String    @id @default(cuid())
  accountId  String
  account    AdAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date       DateTime
  spendCents Int
  currency   String    @default("USD")

  @@unique([accountId, date])
  @@index([date])
}

/// Подключение к TikTok Ads. Как и AdToken, привязано к баеру: всё, что видно
/// под ним, — его расход. Две механики доступа:
///  • kind = "api"    — официальный Marketing API: accessToken (долгоживущий),
///                      опц. appId; ходим на business-api.tiktok.com.
///  • kind = "cookie" — как у FB: куки из антидетекта + прокси кабинета; ходим
///                      во внутренний web-API ads.tiktok.com (пока задел).
model TiktokToken {
  id          String  @id @default(cuid())
  buyerId     String
  buyer       Buyer   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  label       String  @default("")

  kind        String  @default("api") // api | cookie
  accessToken String  @default("")    // Marketing API access_token
  appId       String  @default("")    // опц. app_id (если нужен для запроса)
  cookiesJson String?                 // для kind=cookie: куки антидетекта (JSON)
  proxyUrl    String?                 // http://login:pass@ip:port

  enabled     Boolean   @default(true)
  status      String    @default("ACTIVE") // ACTIVE, TOKEN_EXPIRED, ERROR
  lastSyncAt  DateTime?
  lastError   String    @default("")
  pausedUntil DateTime?

  accounts    TiktokAccount[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// Рекламный кабинет TikTok (advertiser), найденный под токеном.
model TiktokAccount {
  id           String      @id @default(cuid())
  tokenId      String
  token        TiktokToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  advertiserId String      // числовой advertiser_id TikTok
  name         String      @default("")
  currency     String      @default("USD")
  timezone     String      @default("")
  /// status кабинета из TikTok: STATUS_ENABLE (норм), STATUS_DISABLE и пр.
  status       String      @default("STATUS_ENABLE")
  /// Причина, если кабинет ограничен/забанен (справочно).
  statusReason String      @default("")
  balanceCents Int         @default(0)

  enabled      Boolean     @default(true)
  lastSpendAt  DateTime?
  createdAt    DateTime    @default(now())
  days         TiktokAccountDay[]

  @@unique([tokenId, advertiserId])
}

/// Дневной расход по кабинету TikTok — как AdAccountDay для FB.
model TiktokAccountDay {
  id         String        @id @default(cuid())
  accountId  String
  account    TiktokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date       DateTime
  spendCents Int
  currency   String        @default("USD")

  @@unique([accountId, date])
  @@index([date])
}

/// Заявка «хочу в команду» с публичного лендинга: человек оставляет свой ТГ.
/// Смотрит админ (в уведомлениях/списке), связывается сам.
model TeamLead {
  id        String   @id @default(cuid())
  telegram  String
  note      String   @default("")
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Keitaro. Инстанс один на команду, поэтому строка тут ровно одна.
model Tracker {
  id      String  @id @default(cuid())
  /// https://tracker.example.com — без хвоста.
  baseUrl String
  apiKey  String
  enabled Boolean @default(true)

  lastSyncAt DateTime?
  lastError  String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Группа кампаний в Keitaro. Доход делится по группам: группа — это баер.
/// Пока группа не привязана, её доход никуда не попадает и висит в настройках
/// с пометкой — молча терять деньги нельзя.
model TrackerGroup {
  id         String  @id @default(cuid())
  /// id группы в Keitaro.
  externalId String  @unique
  name       String  @default("")
  buyerId    String?
  buyer      Buyer?  @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Лог переводов Brocard (пополнение счёта баера с общего счёта). Каждая
/// операция — живые деньги, поэтому пишем кто/кому/сколько/ответ Brocard.
model BrocardTransfer {
  id         String   @id @default(cuid())
  /// uuid счетов Brocard (acc_...).
  fromAcc    String
  toAcc      String
  /// Баер-получатель, если счёт удалось сопоставить с командой.
  buyerId    String?
  buyer      Buyer?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  amountCents Int
  currency   String   @default("USD")
  comment    String   @default("")
  /// ok — Brocard принял; error — отказал (текст в error).
  status     String   @default("ok")
  error      String   @default("")
  /// Усечённый ответ Brocard — для разбора.
  respJson   String   @default("")
  actorId    String?
  actorName  String   @default("")
  createdAt  DateTime @default(now())

  @@index([buyerId, createdAt])
  @@index([createdAt])
}

/// Магазин доменов. Админ грузит зарегистрированные домены на склад, баер
/// покупает свободный — расход автоматом падает ему в расходники (категория
/// «Домены»), а домен в Keitaro переезжает из группы-склада в группу баера.
model Domain {
  id     String @id @default(cuid())
  /// example.com — в нижнем регистре, без схемы и путей.
  name   String @unique
  /// Доменная зона (TLD), напр. «com», «xyz». Цену держим по зоне.
  zone   String
  /// available — на витрине; sold — куплен баером.
  status String @default("available")

  buyerId String?
  buyer   Buyer?  @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  soldAt  DateTime?
  /// Цена на момент продажи (снимок цены зоны), в центах. Пусто до продажи.
  priceCents Int?
  /// Расходник, который создали при покупке — чтобы откатить при возврате.
  consumableId String?

  /// Keitaro: id домена в трекере (находим по имени при переносе) и признак,
  /// что перенос в группу баера удался. lastError — текст последней ошибки КТ.
  ktId      String @default("")
  ktMoved   Boolean @default(false)
  ktError   String @default("")

  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([status, zone])
  @@index([buyerId])
}

/// Цена доменной зоны (TLD). Одна строка на зону, задаёт админ.
model DomainZonePrice {
  zone       String @id
  priceCents Int
}

/// Brocard — источник РЕАЛЬНОГО расхода: фактические списания с карт. Инстанс
/// один на команду, поэтому строка ровно одна. Адрес API фиксированный, храним
/// только ключ.
model BrocardConfig {
  id      String  @id @default(cuid())
  apiKey  String
  enabled Boolean @default(true)

  lastSyncAt DateTime?
  lastError  String    @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Команда в Brocard. Расход делится по командам: команда — это баер. Пока
/// команда не привязана, её расход никуда не пишется и виден в настройках.
model BrocardTeam {
  id         String  @id @default(cuid())
  /// id команды в Brocard.
  externalId String  @unique
  name       String  @default("")
  buyerId    String?
  buyer      Buyer?  @relation(fields: [buyerId], references: [id], onDelete: SetNull)

  /// Команда-«общак»: её расход — не спенд баера, а расходники на всю команду.
  /// Такой расход не привязывается к человеку и в профит никому не идёт, а
  /// копится отдельной строкой в OverheadDay и виден только на листе овнеров.
  overhead Boolean @default(false)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Расходники на команду по дням — сумма с Brocard-команд, помеченных «общак».
/// Пишется только синком, руками не правится, поэтому просто перезаписывается.
model OverheadDay {
  id         String   @id @default(cuid())
  /// Полночь дня (МСК-день, приведённый к UTC), как и у DayReport.
  date       DateTime @unique
  /// Сумма с Brocard (тело платежа + внутренние сборы), в центах, до накрутки
  /// комиссии за пополнение.
  spendCents Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Фонд баеров — «касса» чистого заработка команды. Виден только админу.
///
/// Баланс = стартовая база (общий бюджет на открут, 1900) + накопленный чистый
/// профит команды по закрытым неделям − выводы. При закрытии недели её
/// «остаётся команде» фиксируется отдельной записью (kind=accrual, по periodId,
/// чтобы не задвоить и убрать при переоткрытии); выводы админ вносит вручную
/// (kind=withdrawal).
model FundEntry {
  id          String   @id @default(cuid())
  kind        String   // 'accrual' | 'withdrawal'
  /// Период-источник для accrual (у withdrawal пусто) — уникален, чтобы неделя
  /// фиксировалась в фонд один раз.
  periodId    String?
  /// Человекочитаемый ключ недели (для accrual) — для показа.
  periodKey   String   @default("")
  /// accrual: +чистый команды за неделю; withdrawal: сумма вывода (вычитается).
  amountCents Int      @default(0)
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@unique([kind, periodId])
  @@index([createdAt])
}

/// Стартовый баланс овнера в кассе на дату-якорь: утверждённая вручную сумма, от
/// которой дальше считается заработок его кабинетов и его выводы. Овнер сам
/// крутит рекламу — его доля это его личные деньги в обороте проекта.
model OwnerCapital {
  id           String   @id @default(cuid())
  buyerId      String   @unique
  buyer        Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  openingCents Int      @default(0)
  /// С какой даты считаем заработок овнера поверх стартового баланса.
  anchorDate   DateTime
  note         String   @default("")
  updatedAt    DateTime @updatedAt
}

/// Личный вывод овнера из оборота — деньги уходят ему на руки и из кассы.
model OwnerWithdrawal {
  id          String   @id @default(cuid())
  buyerId     String
  buyer       Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amountCents Int      @default(0)
  note        String   @default("")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([buyerId])
}

/// Снимок реальных денег по источникам на дату — то, что админ вносит руками и
/// сверяет с тем, что насчитал дашборд (доли овнеров + фонд баеров).
model TreasurySnapshot {
  id            String   @id @default(cuid())
  date          DateTime @unique
  partnersCents Int      @default(0)
  brocardCents  Int      @default(0)
  cardCents     Int      @default(0)
  agentsCents   Int      @default(0)
  note          String   @default("")
  createdAt     DateTime @default(now())
}

/// Прочие движения денег, которых не видит дашборд: внешний залив в оборотку,
/// доход мимо КТ, расход мимо дней. Вносит админ руками — чтобы касса сходилась
/// честно, а каждая сумма была видна строкой. amountCents со знаком:
/// + приход (денег в доле стало больше), − расход.
model CapitalAdjustment {
  id          String   @id @default(cuid())
  /// 'owner' — движение по доле овнера (тогда buyerId заполнен); 'buyers' —
  /// по общему капиталу баеров.
  scope       String
  buyerId     String?
  amountCents Int      @default(0)
  note        String   @default("")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([scope, buyerId])
}

/// Шаблон гео для автозалива: набор стран (+исключения), возраст, пол, дневной
/// бюджет и событие пикселя. Заводит и правит админ — баер при заливе просто
/// выбирает готовый шаблон, чтобы не собирать таргет руками каждый раз.
/// Строки со списками (countries/excluded/genders) — CSV, чтобы схема осталась
/// одинаковой на SQLite и Postgres.
model UploadTemplate {
  id               String   @id @default(cuid())
  /// Владелец шаблона: у каждого свои. Автозалив — общий инструмент, но
  /// шаблоны и настройки к ним личные, чужие не показываем.
  userId           String   @default("")
  name             String
  /// ISO-коды стран через запятую: «US,DE,FR».
  countries        String   @default("")
  /// Исключаемые страны (excluded_geo_locations), через запятую. Пусто — нет.
  excluded         String   @default("")
  /// Исключаемые регионы (области/штаты): JSON-массив [{key,name,cc}] с ключами
  /// FB. Регионы задаются ключом, не именем, поэтому храним и имя для показа.
  excludedRegions  String   @default("")
  /// Исключаемые города (комуны/муниципалитеты): имена через запятую/;. Ключи FB
  /// (city key) резолвим при заливе по имени токеном кабинета. Пусто — нет.
  excludedCities   String   @default("")
  ageMin           Int      @default(18)
  ageMax           Int      @default(65)
  /// Пол: пусто — все; «1» муж; «2» жен; «1,2» — оба явно.
  genders          String   @default("")
  /// Дневной бюджет по умолчанию, в центах. Можно переопределить при заливе.
  dailyBudgetCents Int      @default(2000)
  /// Событие оптимизации пикселя: LEAD/PURCHASE/COMPLETE_REGISTRATION…
  event            String   @default("LEAD")
  /// Кнопка-призыв: LEARN_MORE/SHOP_NOW/SIGN_UP…
  cta              String   @default("LEARN_MORE")
  /// Плейсменты через запятую (ключи из lib/placements). Пусто — авто (Advantage+).
  placements       String   @default("")
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

/// Фиксированный доп. язык для видео-автозалива. У каждого пользователя свой
/// набор (3-4 языка), закреплён за ним и не меняется от залива к заливу: своё
/// видео (ссылкой, чтобы переиспользовать на всех кабах) и свои тексты. При
/// заливе видео эти языки добавляются к основному языку гео как в «Manage
/// languages» Меты.
model UploadLanguage {
  id          String   @id @default(cuid())
  userId      String   @default("")
  /// Локаль Меты: 'af','sq','ar','ro'… (см. lib/locales).
  locale      String
  /// Прямая ссылка на видеофайл этого языка (Meta забирает по file_url) — если
  /// не грузили файлом. Обычно пусто: видео хранится файлом ниже.
  videoUrl    String   @default("")
  /// Видео файлом: байты хранятся у нас, при заливе грузим в каб напрямую.
  videoData   Bytes?
  videoMime   String   @default("")
  videoName   String   @default("")
  headline    String   @default("")
  primaryText String   @default("")
  description String   @default("")
  /// Ссылка лендинга для этого языка (пусто — берём основную).
  link        String   @default("")
  sort        Int      @default(0)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

/// Кэш загруженных в кабинет роликов: тот же файл (по хэшу содержимого) уже был
/// залит и обработан → переиспользуем его video_id, не грузим и не ждём
/// обработку заново. Сильно ускоряет повторные заливы (пак языков — один и тот
/// же). Перед переиспользованием проверяем, что ролик ещё готов (isVideoReady).
model UploadedVideo {
  id                String   @id @default(cuid())
  accountExternalId String
  contentHash       String
  fbVideoId         String
  createdAt         DateTime @default(now())

  @@unique([accountExternalId, contentHash])
  @@index([accountExternalId])
}

/// Запись о запуске автозалива — для истории и разбора, что именно ушло в ФБ.
/// Пишется по факту оркестрации: сколько объявлений создано, в каком режиме,
/// и лог по шагам (текстом). Денег не двигает — это просто журнал.
model UploadJob {
  id           String   @id @default(cuid())
  buyerId      String?
  accountId    String   // AdAccount.id
  accountName  String   @default("")
  campaignName String   @default("")
  /// paused | active | scheduled
  mode         String   @default("paused")
  status       String   @default("running") // running | done | error
  /// static (сторис/фото) | video — чтобы разделить журналы по типу залива
  kind         String   @default("static")
  adsPlanned   Int      @default(0)
  adsCreated   Int      @default(0)
  campaignFbId String   @default("")
  /// текущий этап (для живого статуса в журнале, пока идёт)
  stage        String   @default("")
  log          String   @default("") // построчный журнал шагов
  error        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId])
}
